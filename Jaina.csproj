<Project Sdk="Godot.NET.Sdk/4.5.1">
  <PropertyGroup>
    <!-- 如果你安装了10.0并遇到问题，改下这里 -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>true</ImplicitUsings>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- 临时兼容，建议删除这段，统一由env.props管理路径 -->
    <Sts2Dir>E:\SteamLibrary\steamapps\common\Slay the Spire 2</Sts2Dir>
    <Sts2DataDir>$(Sts2Dir)\data_sts2_windows_x86_64</Sts2DataDir>
    <Sts2ModDir>$(Sts2Dir)\mods</Sts2ModDir>
    <GodotExe>E:\MOD\sts2\Godot_v4.5.1-stable_mono_win64\Godot_v4.5.1-stable_mono_win64\Godot_v4.5.1-stable_mono_win64.exe</GodotExe>
    <!-- 临时兼容结束 -->
  </PropertyGroup>

  <Import Project="env.props" Condition="Exists('env.props')"/>
    
  <ItemGroup>
    <!-- 排除反编译产生的临时目录（含 _decomp：避免反编译源码遮蔽游戏同名类型导致 patch 失效） -->
    <Compile Remove="ritsu_decomp/**" />
    <Compile Remove="game_decomp/**" />
    <Compile Remove="_decomp/**" />
    <Compile Remove="_decomp*/**" />
    <Content Remove="ritsu_decomp/**" />
    <Content Remove="game_decomp/**" />
    <Content Remove="_decomp/**" />
    <Content Remove="_decomp*/**" />
    <Content Include="env.props" />
    <Content Include="env.props.example" />
    <None Remove="ritsu_decomp/**" />
    <None Remove="game_decomp/**" />
    <None Remove="_decomp/**" />
    <None Remove="_decomp*/**" />
    <!-- 反编译输出文本（_decomp_*.txt）同样排除 -->
    <Compile Remove="_decomp_*.txt" />
    <Content Remove="_decomp_*.txt" />
    <None Remove="_decomp_*.txt" />

    <Reference Include="sts2">
      <HintPath>$(Sts2DataDir)/sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <Reference Include="0Harmony">
      <HintPath>$(Sts2DataDir)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- RitsuLib（0.5.11 主包 = 0.110.0 API 面，与游戏 0.110.1 加载的 variant 一致） -->
    <PackageReference Include="STS2.RitsuLib" Version="0.5.12" />

    <!-- MinionLib（随从库，含 source generator：按需生成 Jaina.RitsuAdapters 适配器） -->
    <PackageReference Include="FuYnAloft.Sts2.MinionLib" Version="0.6.2" />
  </ItemGroup>

  <!-- 开发机已订阅工坊 MinionLib，关闭 NuGet 包自动复制到 ModsPath，避免重复部署 -->
  <PropertyGroup>
    <ShouldAutoCopyMinionLib>false</ShouldAutoCopyMinionLib>
  </PropertyGroup>

  <!-- 调试配置：生成 portable pdb（断点调试 + 热重载必需） -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <Optimize>false</Optimize>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <!-- 发布配置：关闭调试符号 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <PathMap>$(AppOutputBase)=.\</PathMap>
  </PropertyGroup>

  <!-- 自动复制dll、json 和本地化文件 -->
  <Target Name="Copy Mod" AfterTargets="PostBuildEvent">
    <Message Text="Copying mod to Slay the Spire 2 mods folder..." Importance="high" />
    <MakeDir Directories="$(Sts2ModDir)\" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(Sts2ModDir)\$(MSBuildProjectName)\" />
    <!-- 拷贝 pdb（断点调试必需；存在才拷） -->
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(Sts2ModDir)\$(MSBuildProjectName)\" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
    <Copy SourceFiles="$(MSBuildProjectName).json" DestinationFolder="$(Sts2ModDir)\$(MSBuildProjectName)/" />
    <!-- 本地化不打到 mods 目录：localization 已随 Godot 导出打进 Jaina.pck，
         游戏从 res://jaina/localization/ 读取，mods 目录无需重复存放 -->
  </Target>

  <!-- 构建后自动用 Godot 导出 pck 到游戏 mods 目录（headless，走 export_presets.cfg 的 Windows Desktop 预设）。
       已实测：与正在运行的 Godot 编辑器并行安全，无需关闭编辑器。
       Condition 防止递归：Godot 导出时会内部执行 dotnet publish（ExportDebug/ExportRelease 配置），
       那一步必须跳过本 target，否则无限循环。 -->
  <Target Name="Export Pck" AfterTargets="Copy Mod" Condition="'$(Configuration)' != 'ExportDebug' and '$(Configuration)' != 'ExportRelease'">
    <Message Text="Exporting pck to $(Sts2ModDir)\$(MSBuildProjectName)\$(MSBuildProjectName).pck ..." Importance="high" />
    <Exec Command="&quot;$(GodotExe)&quot; --headless --path &quot;$(MSBuildProjectDirectory)&quot; --export-pack &quot;Windows Desktop&quot; &quot;$(Sts2ModDir)\$(MSBuildProjectName)\$(MSBuildProjectName).pck&quot;" />
  </Target>

  <!-- 复制运行库到 .NET 输出目录：sts2/0Harmony/RitsuLib/MinionLib/System.IO.Hashing
       Godot 编辑器加载 Jaina.dll 时 AssemblyLoadContext 从输出目录解析这些依赖 -->
  <Target Name="Copy Runtime Dependencies" AfterTargets="Build">
    <ItemGroup>
      <RuntimeDependency Include="$(Sts2DataDir)/sts2.dll" />
      <RuntimeDependency Include="$(Sts2DataDir)/0Harmony.dll" />
      <RuntimeDependency Include="$(NuGetPackageRoot)sts2.ritsulib\0.5.11\lib\net9.0\STS2-RitsuLib.dll" Condition="Exists('$(NuGetPackageRoot)sts2.ritsulib\0.5.11\lib\net9.0\STS2-RitsuLib.dll')" />
      <RuntimeDependency Include="$(NuGetPackageRoot)fuynaloft.sts2.minionlib\0.6.2\lib\net9.0\MinionLib.dll" Condition="Exists('$(NuGetPackageRoot)fuynaloft.sts2.minionlib\0.6.2\lib\net9.0\MinionLib.dll')" />
      <!-- RitsuLib 的依赖包（若无 NuGet 缓存可改为从本地 lib 目录引用） -->
      <RuntimeDependency Include="$(NuGetPackageRoot)system.io.hashing\9.0.0\lib\net9.0\System.IO.Hashing.dll" Condition="Exists('$(NuGetPackageRoot)system.io.hashing\9.0.0\lib\net9.0\System.IO.Hashing.dll')" />
    </ItemGroup>
    <Copy SourceFiles="@(RuntimeDependency)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>